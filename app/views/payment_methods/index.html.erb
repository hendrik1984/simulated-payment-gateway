<% content_for :page_styles do %>
  <%= stylesheet_link_tag 'payment_methods' %>
<% end %>

<div class="container">
    <!-- header -->
    <div class="page-header">
        <h1>Payment Methods</h1>
        <p>Manage which payment methods are available to clients.</p>
    </div>

    <!-- table card -->
    <div class="table-card">
        <table class="payment-table">
        <thead>
            <tr>
            <th>Name</th>
            <th>Code</th>
            <th>Status</th>
            <th>Action</th>
            </tr>
        </thead>
            <tbody>
                <% @payment_methods.each do |pm| %>
                    <tr>
                        <td class="col-name"><%= pm.name %></td>
                        <td class="col-code"><%= pm.code %></td>
                        <td>
                            <% if pm.enabled? %>
                                <span class="status-enabled">
                                Enabled
                                </span>
                            <% else %>
                                <span class="status-disabled">
                                Disabled
                                </span>
                            <% end %>
                        <td class="col-action">
                            <%= button_to(
                                pm.enabled? ? "Disable" : "Enable",
                                toggle_payment_method_path(pm),
                                method: :patch,
                                class: "action-btn"
                            ) %>
                        </td>
                    </tr>  
                <% end %>
            </tbody>
        </table>
    </div>
</div>